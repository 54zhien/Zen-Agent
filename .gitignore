# macOS
.DS_Store

# Xcode / Swift build products
DerivedData/
build/
.build/
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Archives / exported artifacts
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Test / build result bundles
*.xcresult

# Local environment / secrets
.env
.env.*
!.env.example
Secrets.xcconfig
*.xcconfig.local

# Apple signing material — must never be committed.
# .gitignore is a backstop, not a storage plan: signing material reaches CI through
# GitHub Secrets / App Store Connect API keys. See Config/Secrets.xcconfig.example.
AuthKey_*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# Generated by XcodeGen. project.yml is the source of truth — regenerate with
# `xcodegen generate`. See Docs/ADR/0002-project-generation-xcodegen.md.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
App/Info.plist

# Local tooling caches
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.idea/
.vscode/

# Keep source, config, docs and bundled resources versioned.
